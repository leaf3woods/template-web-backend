root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Use `var` for every local variable declaration with an inferred type.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Make accessibility visible at every declaration.
dotnet_style_require_accessibility_modifiers = always:silent

# Prefer braces for every control-flow body.
csharp_prefer_braces = true:suggestion

# Mark private fields readonly when their values are assigned only during initialization.
dotnet_style_readonly_field = true:silent

# Remove imports that do not contribute to the compiled source.
dotnet_diagnostic.IDE0005.severity = silent

# Use `namespace Example;` when the file can use a file-scoped namespace.
csharp_style_namespace_declarations = file_scoped:suggestion

# EF Core migrations are versioned generated artifacts. Preserve their generated source shape.
[**/Repositories/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0040.severity = none
dotnet_diagnostic.IDE0044.severity = none
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0161.severity = none

# Keep these structural transformations disabled until the template adopts a team-wide style.
# To opt in later, replace each disable with the commented setting below.
# csharp_style_prefer_top_level_statements = true:suggestion
dotnet_diagnostic.IDE0210.severity = none
# csharp_style_prefer_primary_constructors = true:suggestion
dotnet_diagnostic.IDE0290.severity = none
